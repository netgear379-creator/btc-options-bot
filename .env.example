# Alpaca credentials (paper trading by default)
ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE
ALPACA_PAPER=True

# Live trading needs BOTH ALPACA_PAPER=False and the line below, uncommented.
# Read the "What this backtest does not prove" section of README.md first.
# ALLOW_LIVE_TRADING=I_UNDERSTAND_THE_RISK

# Any config.py value can be overridden here, e.g.:
# RISK_PER_TRADE_PCT=0.005
# MIN_VRP_RATIO=1.20
